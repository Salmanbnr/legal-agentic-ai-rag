# Copy to .env and replace every "replace-me" value.
# Never commit a real .env file.

APP_ENV=development
API_PREFIX=/api/v1

# Logging. Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_FILE is optional; relative paths resolve against backend/. Leave empty
# for console output only. Restart the server after changing either value.
LOG_LEVEL=INFO
LOG_FILE=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_SECONDS=1
OPENAI_RETRY_MAX_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=1500

PINECONE_API_KEY=replace-me
PINECONE_INDEX_NAME=legal-evidence
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine
PINECONE_UPSERT_BATCH_SIZE=100
PINECONE_DELETE_BATCH_SIZE=1000
PINECONE_RETRY_ATTEMPTS=4
PINECONE_RETRY_BASE_SECONDS=0.5
PINECONE_RETRY_MAX_SECONDS=8

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
MODEL_CACHE_DIR=.cache/huggingface
TEMP_DIR=.tmp

MAX_UPLOAD_MB=50
MAX_PDF_PAGES=1000
UPLOAD_RATE_LIMIT_PER_MINUTE=30
INGEST_PIPELINE_VERSION=1.0.0
PDF_NATIVE_TEXT_DENSITY_THRESHOLD=0.0002

# OCR. TESSERACT_CMD is optional; leave empty to use PATH.
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_CONFIDENCE_THRESHOLD=70
OCR_PREPROCESS_ENABLED=true
OCR_HANDWRITING_CONFIDENCE_THRESHOLD=35
OCR_HANDWRITING_MAX_WORDS=5
OCR_TABLE_MIN_ROWS=3
OCR_MAX_DESKEW_DEGREES=15
TESSERACT_CMD=

# Quality status thresholds.
QUALITY_REVIEW_RATIO_THRESHOLD=0.30
QUALITY_PARSER_ERROR_THRESHOLD=3

# Conservative normalization and token-bounded chunking.
HEADER_FOOTER_REPEAT_RATIO=0.60
HEADER_FOOTER_MAX_LINES=3
CHUNK_MIN_TOKENS=150
CHUNK_MAX_TOKENS=220
CHUNK_OVERLAP_MIN_TOKENS=20
CHUNK_OVERLAP_MAX_TOKENS=40
CHUNK_TOKENIZER_LOCAL_FILES_ONLY=false
INDEX_SCHEMA_VERSION=1

# Hybrid retrieval. Candidates are top_k times the multiplier, and one
# document may take at most RETRIEVAL_MAX_SPANS_PER_DOCUMENT result slots.
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_MAX_SPANS_PER_DOCUMENT=3
RETRIEVAL_NEIGHBOR_EXPANSION=true

# Validate the embedding dimension against Pinecone during startup.
STARTUP_CHECKS_ENABLED=true

# Set false in the API when running scripts.run_worker as a separate process.
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_BASE_SECONDS=2
WORKER_BACKOFF_MAX_SECONDS=60

AGENT_MAX_STEPS=24
AGENT_MAX_RETRIEVAL_RETRIES=2
AGENT_MAX_LLM_CALLS=12
AGENT_MAX_TOKENS=20000
AGENT_TIMEOUT_SECONDS=60
# Skip the facts analyst for a simple fact lookup with strong evidence.
AGENT_SKIP_ANALYST_ON_STRONG_FACT_LOOKUP=true
AGENT_ANALYST_MIN_SPANS=3
AGENT_ANALYST_MAX_SPANS=12
AGENT_RESEARCH_MAX_MULTI_HOP=1

# Baseline answering budget. The evidence budget caps how many passages reach
# the model, and the call budget caps how many model calls one request may use.
ANSWER_MAX_EVIDENCE_SPANS=10
ANSWER_MAX_QUESTION_LENGTH=2000
ANSWER_MAX_LLM_CALLS=1

FRONTEND_ORIGIN=http://localhost:3000
