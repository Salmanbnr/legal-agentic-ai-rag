# Public app origin (used for absolute links and auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side base URL for the FastAPI service. Not exposed to the browser.
AI_BACKEND_BASE_URL=http://localhost:8000

# Server-side deadlines in milliseconds. A wedged backend must surface as an
# error instead of a page that never finishes loading.
AI_BACKEND_TIMEOUT_MS=30000
AI_BACKEND_UPLOAD_TIMEOUT_MS=180000
AI_BACKEND_ANSWER_TIMEOUT_MS=120000

# Supabase project values. The publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
